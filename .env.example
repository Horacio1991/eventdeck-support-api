PORT=
NODE_ENV=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Opcional, solo diagnóstico; nunca autoriza notificaciones.
MP_WEBHOOK_SECRET_PRODUCTION_DIAGNOSTIC=
# TEMPORAL: expone solo x-request-id, x-signature y manifest.
MP_WEBHOOK_RAW_DIAGNOSTIC=false
BASE_URL=
FRONTEND_URL=
SUPPORT_AMOUNT=
SUPPORT_CURRENCY=
CORS_ORIGIN=
TRUST_PROXY_HOPS=

# Opcional: ausente o disabled conserva las descargas deshabilitadas.
# r2 exige TODOS los valores siguientes; no usar las credenciales de Mercado Pago.
VISUAL_PACK_STORAGE_PROVIDER=disabled
# Ejemplo de forma: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Ruta relativa exacta del objeto privado; no una URL.
R2_VISUAL_PACK_OBJECT_KEY=
