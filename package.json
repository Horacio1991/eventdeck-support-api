{
  "name": "eventdeck-support-api", "version": "0.1.0", "private": true,
  "description": "Prueba independiente de Mercado Pago Checkout Pro Preferences; sin entrega de archivos",
  "type": "module", "engines": {"node": ">=22 <25"},
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {"express": "5.3.0", "helmet": "8.3.0", "express-rate-limit": "8.7.1"},
  "devDependencies": {"@types/express": "^5.0.0", "@types/node": "^24.0.0", "typescript": "~5.9.3", "tsx": "^4.20.0"}
}
